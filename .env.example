GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
GATEWAY_PUBLIC_URL=http://localhost:8080

WEBSITE_BASE_URL=https://typst-gost.ru
TELEGRAM_BOT_URL=http://localhost:8081
CORS_ALLOWED_ORIGINS=https://typst-gost.ru,http://localhost:3000

ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_me_strong_password
ADMIN_API_KEY=
JWT_SECRET_KEY=change_me_random_64_char_secret
JWT_TTL_SECONDS=86400

POLZA_AI_API_KEY=your_polza_api_key
POLZA_BASE_URL=https://polza.ai/api/v1
POLZA_API_ROOT=https://polza.ai/api

RAG_EMBEDDING_MODEL=qwen/qwen3-embedding-8b

WEBSITE_CHAT_MODEL=deepseek/deepseek-v4.1-flash-1017
WEBSITE_GUARD_MODEL=google/gemini-decision-1
TELEGRAM_CHAT_MODEL=deepseek/deepseek-v4.1-flash-1017
TELEGRAM_GUARD_MODEL=google/gemini-decision-1
EXTERNAL_CHAT_MODEL=deepseek/deepseek-v4.1-flash-1017
EXTERNAL_GUARD_MODEL=google/gemini-decision-1

RAG_GUARD_ENABLED=true
RAG_GUARD_OFFTOPIC_THRESHOLD=0.85
RAG_GUARD_NOUL_THRESHOLD=0.80
RAG_GUARD_TIMEOUT=3.0
RAG_GUARD_DEBUG=false

RAG_MIN_SCORE=0.40
RAG_REL_RATIO=0.72
RAG_MAX_SOURCES=5
RAG_SEARCH_LIMIT=24
RAG_MAX_PAGE_CHARS=10000
RAG_MAX_TOTAL_CONTEXT_CHARS=24000

DATA_DIR=data
DOCS_BASE_URL=https://typst-gost.ru
DOCS_REPO_SLUG=typst-gost/website
DOCS_REPO_BRANCH=main
DOCS_REPO_DOCS_SUBDIR=content/docs
DOCS_REPO_ASSETS_SUBDIR=public/docs/compile_assets
SYNC_DOCS_ON_START=true

RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60

LOG_LEVEL=INFO
LOG_FILE=